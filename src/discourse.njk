---
title: The Discourse
layout: false
permalink: /discourse/index.html
---
{% include "header.njk" %}

<div class="page-header">
  <h1>The Discourse</h1>
  <p>Hot takes, unpopular opinions, and cultural arguments.</p>
</div>

<div class="page-content">
  <div class="article-list">
    {% for article in collections.discourse %}
    <a href="{{ article.url }}" class="article-card">
      {% if article.data.heroImage %}
      <img src="{{ article.data.heroImage }}" alt="{{ article.data.title }}" class="article-card-img" />
      {% endif %}
      <span class="article-card-cat">{{ article.data.categoryLabel }}</span>
      <h3 class="article-card-title">{{ article.data.title }}</h3>
      {% if article.data.dek %}<p class="article-card-excerpt">{{ article.data.dek }}</p>{% endif %}
      <p class="article-card-meta">{{ article.data.author }} &nbsp;&middot;&nbsp; {{ article.date | readableDate }}</p>
    </a>
    {% else %}
    <p style="color:var(--muted);font-style:italic;">No pieces yet. <a href="/submit" style="color:#FF2D8A;">Submit your work.</a></p>
    {% endfor %}
  </div>
</div>

{% include "footer.njk" %}
